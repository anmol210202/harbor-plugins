{
  "name": "harbor-plugins",
  "version": "1.0.0",
  "description": "Multi-repository management and hosting system for Harbor Manga and eBook plugins",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsx scripts/build.ts",
    "validate": "tsx scripts/validate.ts",
    "typecheck": "tsc --noEmit",
    "serve": "tsx scripts/serve.ts",
    "proxy": "cd server && npm start",
    "proxy:dev": "cd server && npm run dev"
  },
  "keywords": [
    "harbor",
    "manga",
    "ebook",
    "plugins",
    "extensions",
    "reader"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.4.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
